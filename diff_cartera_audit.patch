+// === CARTERA_AGGREGATION_START ===
+// Auditoría del 24/8: mismo bug de Fase 1 (una suma parcial presentada como si fuera
+// completa) encontrado en la pestaña Cartera. Si algunos holdings de una clase (o de la
+// cartera entera) no tienen precio en vivo disponible todavía, la suma de los que SÍ lo
+// tienen se mostraba tal cual, sin ningún aviso — indistinguible de un total real.
+// Esta función agrega el valor y devuelve explícitamente si el resultado es parcial,
+// vacío (sin holdings) o totalmente desconocido (hay holdings pero ninguno con precio).
+function aggregateHoldingsCurrentValue(holdingsSubset){
+  const withValue = holdingsSubset.filter(h => h.current != null);
+  const total = holdingsSubset.length;
+  const known = withValue.length;
+  const isEmpty = total === 0;
+  const isFullyUnknown = total > 0 && known === 0;
+  const isPartial = known > 0 && known < total;
+  const sum = known > 0 ? withValue.reduce((a, h) => a + h.current, 0) : (isEmpty ? 0 : null);
+  return { sum, isPartial, isEmpty, isFullyUnknown, total, known };
+}
+// === CARTERA_AGGREGATION_END ===
